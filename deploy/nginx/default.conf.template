server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 64m;

  # 健康检查（install.sh / compose healthcheck 共用）
  location = /healthz {
    default_type text/plain;
    return 200 'ok\n';
  }

  # 代理路由探测：确认镜像里已包含火山代理（GET 应返回 200，而不是 404）
  location = /opc-proxy/ark/healthz {
    default_type application/json;
    add_header Cache-Control "no-store";
    add_header X-Opc-Ark-Upstream "${ARK_UPSTREAM}";
    return 200 '{"ok":true,"proxy":"volcengine-ark"}\n';
  }

  # 同源火山方舟 Seedream 代理（必须写在 location / 之前）
  # 浏览器 → /opc-proxy/ark/api/v3/images/generations
  # 上游   → ${ARK_UPSTREAM}/api/v3/images/generations
  #
  # 注意：这里刻意用「变量 + resolver」而不是写死域名。
  # 写死域名时 nginx 在启动阶段就要解析 DNS，内网 DNS 不通会直接起不来；
  # 变量形式则改为每次请求解析，站点始终可用。
  location = /opc-proxy/ark/api/v3/images/generations {
    limit_except POST OPTIONS {
      deny all;
    }

    resolver 127.0.0.11 ipv6=off valid=30s;
    set $ark_upstream ${ARK_UPSTREAM};
    set $ark_host ${ARK_HOST};
    proxy_pass $ark_upstream/api/v3/images/generations;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name $ark_host;
    proxy_ssl_verify off;
    proxy_set_header Host $ark_host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Content-Type $http_content_type;
    proxy_set_header Cookie "";
    proxy_hide_header Set-Cookie;
    proxy_read_timeout 240s;
    proxy_send_timeout 240s;
    proxy_connect_timeout 30s;
    proxy_buffering off;
    # nginx 自身的 5xx 不要以 HTML 返回，前端据此判断“代理坏了”
    error_page 502 503 504 = @ark_unavailable;
  }

  # 代理失败时返回 JSON，避免前端收到 nginx 的 HTML 错误页
  location @ark_unavailable {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 502 '{"error":{"type":"proxy_unavailable","message":"cannot reach ${ARK_HOST} from the server; check DNS/network or call Ark directly"}}\n';
  }

  # 同源 Atomflow 图片编辑代理
  location = /opc-proxy/site/v1/images/edits {
    limit_except POST OPTIONS {
      deny all;
    }
    proxy_pass https://atomflow.vip/v1/images/edits;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_verify off;
    proxy_set_header Host atomflow.vip;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie "";
    proxy_hide_header Set-Cookie;
    proxy_read_timeout 240s;
    proxy_send_timeout 240s;
  }

  location = /opc-proxy/api/v1/images/edits {
    limit_except POST OPTIONS {
      deny all;
    }
    proxy_pass https://api.atomflow.vip/v1/images/edits;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_verify off;
    proxy_set_header Host api.atomflow.vip;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie "";
    proxy_hide_header Set-Cookie;
    proxy_read_timeout 240s;
    proxy_send_timeout 240s;
  }

  location ~* \.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff2?)$ {
    expires 7d;
    add_header Cache-Control "public";
    try_files $uri =404;
  }

  # SPA：已存在的静态资源直接返回；其余回退 index.html
  location / {
    try_files $uri $uri/ /index.html;
  }
}
