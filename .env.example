# ---- 内网 Docker 部署（deploy/install.sh / docker compose）----
OPC_PORT=5200
OPC_BIND_IP=0.0.0.0
TZ=Asia/Shanghai

# ---- 前端构建期变量（改了必须重新 build 镜像）----
